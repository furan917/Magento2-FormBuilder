<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">furan_formbuilder_submission_listing.furan_formbuilder_submission_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="export" class="Furan\FormBuilder\Block\Adminhtml\Submission\ExportButton"/>
        </buttons>
        <spinner>furan_formbuilder_submission_columns</spinner>
        <deps>
            <dep>furan_formbuilder_submission_listing.furan_formbuilder_submission_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="furan_formbuilder_submission_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">submission_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
            <filterUrlParams>
                <param name="form_id">*</param>
            </filterUrlParams>
        </settings>
        <aclResource>Furan_FormBuilder::submissions</aclResource>
        <dataProvider class="Furan\FormBuilder\Ui\DataProvider\SubmissionListing" name="furan_formbuilder_submission_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>submission_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <filterSearch name="fulltext">
            <settings>
                <placeholder translate="true">Search by reference</placeholder>
            </settings>
        </filterSearch>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction" class="Furan\FormBuilder\Ui\Component\MassAction" component="Magento_Ui/js/grid/tree-massactions">
            <argument name="data" xsi:type="array">
                <item name="acl" xsi:type="array">
                    <item name="delete" xsi:type="string">Furan_FormBuilder::submissions_delete</item>
                    <item name="status" xsi:type="string">Furan_FormBuilder::submissions_reply</item>
                </item>
            </argument>
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected submissions and their files?</message>
                        <title translate="true">Delete submissions</title>
                    </confirm>
                    <url path="furanform/submission/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status">
                <settings>
                    <type>status</type>
                    <label translate="true">Change status</label>
                    <actions>
                        <action name="0">
                            <url path="furanform/submission/massStatus">
                                <param name="status">0</param>
                            </url>
                            <type>status_new</type>
                            <label translate="true">New</label>
                        </action>
                        <action name="1">
                            <url path="furanform/submission/massStatus">
                                <param name="status">1</param>
                            </url>
                            <type>status_in_progress</type>
                            <label translate="true">In progress</label>
                        </action>
                        <action name="2">
                            <url path="furanform/submission/massStatus">
                                <param name="status">2</param>
                            </url>
                            <type>status_answered</type>
                            <label translate="true">Answered</label>
                        </action>
                        <action name="3">
                            <url path="furanform/submission/massStatus">
                                <param name="status">3</param>
                            </url>
                            <type>status_closed</type>
                            <label translate="true">Closed</label>
                        </action>
                    </actions>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="furan_formbuilder_submission_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>submission_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>55</resizeDefaultWidth>
            </settings>
        </selectionsColumn>
        <column name="submission_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="reference" class="Furan\FormBuilder\Ui\Component\Listing\Column\Reference">
            <settings>
                <label translate="true">Reference</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="form_id" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Furan\FormBuilder\Model\Source\AllForms"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Form</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="summary">
            <settings>
                <label translate="true">Summary</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store">
            <settings>
                <label translate="true">Store View</label>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="customer_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Customer ID</label>
            </settings>
        </column>
        <column name="is_read" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options>
                    <option name="yes" xsi:type="array">
                        <item name="value" xsi:type="number">1</item>
                        <item name="label" xsi:type="string" translate="true">Yes</item>
                    </option>
                    <option name="no" xsi:type="array">
                        <item name="value" xsi:type="number">0</item>
                        <item name="label" xsi:type="string" translate="true">No</item>
                    </option>
                </options>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Read</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Furan\FormBuilder\Model\Source\SubmissionStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Submitted</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Furan\FormBuilder\Ui\Component\Listing\Column\SubmissionActions">
            <settings>
                <indexField>submission_id</indexField>
                <resizeEnabled>false</resizeEnabled>
                <resizeDefaultWidth>107</resizeDefaultWidth>
            </settings>
        </actionsColumn>
    </columns>
</listing>
