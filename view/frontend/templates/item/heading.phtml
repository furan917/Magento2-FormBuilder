<?php
/** @var \Magento\Framework\DataObject $block */
/** @var \Magento\Framework\Escaper $escaper */
$item = $block->getData('item');
$width = in_array($item['width'] ?? '', ['full', 'two_thirds', 'half', 'third'], true) ? $item['width'] : 'full';
?>
<?php $level = min(4, max(2, (int)($item['level'] ?? 2))); ?>
<div class="ffb-item ffb-content ffb-content-heading ffb-w-<?= $escaper->escapeHtmlAttr($width) ?>" data-ffb-item="<?= $escaper->escapeHtmlAttr($item['id'] ?? '') ?>">
    <h<?= (int)$level ?> class="ffb-heading"><?= $escaper->escapeHtml($item['text'] ?? '') ?></h<?= (int)$level ?>>
</div>
