<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="furan_formbuilder_recaptcha_unavailable" xsi:type="string">Furan\FormBuilder\Model\System\Message\RecaptchaUnavailable</item>
                <item name="furan_formbuilder_stats_rebuild_needed" xsi:type="string">Furan\FormBuilder\Model\System\Message\StatsRebuildNeeded</item>
            </argument>
        </arguments>
    </type>
    <type name="Furan\FormBuilder\Controller\Adminhtml\Submission\Open">
        <plugin name="furan_formbuilder_submission_link_login" type="Furan\FormBuilder\Plugin\Admin\SubmissionLinkLogin" sortOrder="10"/>
    </type>
    <type name="Magento\Backend\Model\Url">
        <plugin name="furan_formbuilder_submission_link_login" type="Furan\FormBuilder\Plugin\Admin\SubmissionLinkLogin"/>
    </type>
    <type name="Furan\FormBuilder\Plugin\Admin\SubmissionLinkLogin">
        <arguments>
            <argument name="authSession" xsi:type="object">Magento\Backend\Model\Auth\Session\Proxy</argument>
            <argument name="session" xsi:type="object">Magento\Backend\Model\Session\Proxy</argument>
            <argument name="backendUrl" xsi:type="object">Magento\Backend\Model\UrlInterface\Proxy</argument>
        </arguments>
    </type>
</config>
