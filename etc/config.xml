<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <furan_formbuilder>
            <general>
                <enabled>1</enabled>
                <route_prefix>forms</route_prefix>
                <async_actions>0</async_actions>
            </general>
            <spam>
                <min_seconds>3</min_seconds>
                <rate_limit>10</rate_limit>
                <form_rate_limit>200</form_rate_limit>
                <rate_window_minutes>10</rate_window_minutes>
                <trusted_proxies/>
            </spam>
            <uploads>
                <max_size_mb>5</max_size_mb>
                <form_budget_mb>500</form_budget_mb>
                <allowed_extensions>pdf,jpg,jpeg,png,gif,webp,txt,csv,docx,xlsx,odt,ods</allowed_extensions>
            </uploads>
            <privacy>
                <retention_days>0</retention_days>
                <draft_ttl_hours>24</draft_ttl_hours>
                <on_customer_delete>anonymise</on_customer_delete>
            </privacy>
            <maps>
                <provider>osm</provider>
                <google_api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <google_map_id></google_map_id>
                <tile_url>https://tile.openstreetmap.org/{z}/{x}/{y}.png</tile_url>
                <attribution>&amp;copy; &lt;a href="https://www.openstreetmap.org/copyright"&gt;OpenStreetMap&lt;/a&gt; contributors</attribution>
                <max_zoom>19</max_zoom>
                <search_enabled>0</search_enabled>
                <search_endpoint>https://nominatim.openstreetmap.org/search</search_endpoint>
            </maps>
            <customers>
                <claim_enabled>1</claim_enabled>
                <draft_sync>1</draft_sync>
                <draft_days>30</draft_days>
                <replies_enabled>1</replies_enabled>
                <guest_reply_links>1</guest_reply_links>
                <max_thread_messages>200</max_thread_messages>
            </customers>
            <analytics>
                <enabled>1</enabled>
            </analytics>
            <webhooks>
                <retention_days>30</retention_days>
            </webhooks>
            <email>
                <sender_identity>general</sender_identity>
                <async>0</async>
                <autoresponder_daily_limit>500</autoresponder_daily_limit>
                <reply_to/>
                <notification_template>furan_formbuilder_email_notification_template</notification_template>
                <autoresponder_template>furan_formbuilder_email_autoresponder_template</autoresponder_template>
                <reply_template>furan_formbuilder_email_reply_template</reply_template>
                <customer_reply_template>furan_formbuilder_email_customer_reply_template</customer_reply_template>
                <claim_template>furan_formbuilder_email_claim_template</claim_template>
            </email>
        </furan_formbuilder>
        <recaptcha_frontend>
            <type_for>
                <furan_formbuilder/>
            </type_for>
        </recaptcha_frontend>
    </default>
</config>
