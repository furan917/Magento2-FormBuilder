<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="furan_formbuilder.mail" queue="furan_formbuilder.mail" handler="Furan\FormBuilder\Model\Mail\MailConsumer::process"/>
    <consumer name="furan_formbuilder.export" queue="furan_formbuilder.export" handler="Furan\FormBuilder\Model\Export\ExportConsumer::process"/>
    <consumer name="furan_formbuilder.action" queue="furan_formbuilder.action" handler="Furan\FormBuilder\Model\Action\ActionConsumer::process"/>
    <consumer name="furan_formbuilder.webhook" queue="furan_formbuilder.webhook" handler="Furan\FormBuilder\Model\Webhook\WakeConsumer::process"/>
    <consumer name="furan_formbuilder.privacy" queue="furan_formbuilder.privacy" handler="Furan\FormBuilder\Model\Privacy\DeletedAccountConsumer::process"/>
</config>
