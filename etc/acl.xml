<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Furan_FormBuilder::formbuilder" title="Form Builder" translate="title" sortOrder="80">
                        <resource id="Furan_FormBuilder::forms" title="View Forms" translate="title" sortOrder="10">
                            <resource id="Furan_FormBuilder::forms_save" title="Create and Edit Forms" translate="title" sortOrder="10"/>
                            <resource id="Furan_FormBuilder::forms_delete" title="Delete Forms" translate="title" sortOrder="20"/>
                        </resource>
                        <resource id="Furan_FormBuilder::submissions" title="View Submissions" translate="title" sortOrder="20">
                            <resource id="Furan_FormBuilder::submissions_reply" title="Reply to Submissions and Change Status" translate="title" sortOrder="10"/>
                            <resource id="Furan_FormBuilder::submissions_files" title="Download Uploaded Files" translate="title" sortOrder="20"/>
                            <resource id="Furan_FormBuilder::submissions_export" title="Export Submissions" translate="title" sortOrder="30"/>
                            <resource id="Furan_FormBuilder::submissions_delete" title="Delete Submissions" translate="title" sortOrder="40"/>
                            <resource id="Furan_FormBuilder::analytics" title="View Analytics" translate="title" sortOrder="50"/>
                            <resource id="Furan_FormBuilder::privacy" title="Privacy: Export or Erase a Person's Data" translate="title" sortOrder="60"/>
                        </resource>
                        <resource id="Furan_FormBuilder::rules" title="View Validation Rules" translate="title" sortOrder="35">
                            <resource id="Furan_FormBuilder::rules_save" title="Create, Edit and Delete Validation Rules" translate="title" sortOrder="10"/>
                        </resource>
                        <resource id="Furan_FormBuilder::field_groups" title="View Field Groups" translate="title" sortOrder="30">
                            <resource id="Furan_FormBuilder::field_groups_edit" title="Save and Edit Field Groups" translate="title" sortOrder="10"/>
                            <resource id="Furan_FormBuilder::field_groups_delete" title="Delete Field Groups" translate="title" sortOrder="20"/>
                        </resource>
                        <resource id="Furan_FormBuilder::webhooks" title="View Webhooks" translate="title" sortOrder="40">
                            <resource id="Furan_FormBuilder::webhooks_manage" title="Manage Webhook Endpoints" translate="title" sortOrder="10"/>
                            <resource id="Furan_FormBuilder::webhooks_personal" title="Allow Webhooks to Send Personal Data" translate="title" sortOrder="20"/>
                            <resource id="Furan_FormBuilder::webhooks_replay" title="Replay Webhook Deliveries" translate="title" sortOrder="30"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Furan_FormBuilder::config" title="Form Builder" translate="title" sortOrder="200"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
