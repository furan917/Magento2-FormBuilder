  {
    "name": "relative date uses today in the visibility pass",
    "schema": {
      "version": 1,
      "pages": [
        {
          "id": "p_aaaa",
          "title": "p",
          "condition": null,
          "items": [
            {
              "id": "f_aaaa",
              "kind": "field",
              "type": "date",
              "name": "when",
              "label": "when",
              "condition": null,
              "relative_date": "Y-m-d"
            },
            {
              "id": "f_bbbb",
              "kind": "field",
              "type": "text",
              "name": "b",
              "label": "b",
              "condition": {
                "actions": [
                  {
                    "action": "show"
                  }
                ],
                "match": "all",
                "rules": [
                  {
                    "field": "when",
                    "operator": "greater_than",
                    "value_date": {
                      "days": 0
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "values": {
      "when": "2026-11-08"
    },
    "today": "2026-11-07",
    "expected": {
      "p_aaaa": true,
      "f_aaaa": true,
      "f_bbbb": true
    }
  },
