[
  {"name": "empty text renders nothing", "text": "  \n\n ", "html": ""},
  {"name": "blank lines split paragraphs and single newlines break lines", "text": "One\r\ntwo\n\n\nThree", "html": "<p>One<br>\ntwo</p>\n<p>Three</p>"},
  {"name": "bold, italic and both", "text": "a **b** and *c* and ***d***", "html": "<p>a <strong>b</strong> and <em>c</em> and <strong><em>d</em></strong></p>"},
  {"name": "unbalanced markers stay text", "text": "2 * 3 ** 4 *x", "html": "<p>2 * 3 ** 4 *x</p>"},
  {"name": "bulleted list", "text": "- one\n- two **b**", "html": "<ul><li>one</li><li>two <strong>b</strong></li></ul>"},
  {"name": "numbered list between paragraphs", "text": "Steps:\n1. First\n2. Second\n\nDone", "html": "<p>Steps:</p>\n<ol><li>First</li><li>Second</li></ol>\n<p>Done</p>"},
  {"name": "list type change starts a new list", "text": "- a\n1. b", "html": "<ul><li>a</li></ul>\n<ol><li>b</li></ol>"},
  {"name": "blank line separates numbered lists", "text": "1. a\n\n10. b", "html": "<ol><li>a</li></ol>\n<ol><li>b</li></ol>"},
  {"name": "near misses are not lists", "text": "-not a list\n1.not\n1234. no\n- ", "html": "<p>-not a list<br>\n1.not<br>\n1234. no<br>\n-</p>"},
  {"name": "https link gets nofollow rel and new tab", "text": "[Shop](https://example.com/a?x=1&y=2)", "html": "<p><a href=\"https://example.com/a?x=1&amp;y=2\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">Shop</a></p>"},
  {"name": "upper-case scheme is accepted", "text": "[x](HTTPS://Example.com)", "html": "<p><a href=\"HTTPS://Example.com\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">x</a></p>"},
  {"name": "mailto link", "text": "[Mail us](mailto:help@example.com)", "html": "<p><a href=\"mailto:help@example.com\" rel=\"noopener noreferrer nofollow\">Mail us</a></p>"},
  {"name": "formatting inside a link label", "text": "[**b**](https://e.com)", "html": "<p><a href=\"https://e.com\" rel=\"noopener noreferrer nofollow\" target=\"_blank\"><strong>b</strong></a></p>"},
  {"name": "relative links are text in messages", "text": "[x](/privacy)", "html": "<p>[x](/privacy)</p>"},
  {"name": "protocol-relative link is text", "text": "[x](//evil.com)", "html": "<p>[x](//evil.com)</p>"},
  {"name": "javascript link is text", "text": "[x](javascript:alert(1))", "html": "<p>[x](javascript:alert(1))</p>"},
  {"name": "mixed-case javascript link is text", "text": "[x](JaVaScRiPt:alert)", "html": "<p>[x](JaVaScRiPt:alert)</p>"},
  {"name": "data link is text", "text": "[x](data:text/html;base64,AAAA)", "html": "<p>[x](data:text/html;base64,AAAA)</p>"},
  {"name": "empty host is text", "text": "[x](http://)", "html": "<p>[x](http://)</p>"},
  {"name": "quote cannot break out of href", "text": "[a](https://e.com/\"x)", "html": "<p>[a](https://e.com/&quot;x)</p>"},
  {"name": "mailto with extra headers is text", "text": "[x](mailto:a@b.com?cc=c@d.com) [y](mailto:a@b.com%0Abcc@evil.com)", "html": "<p>[x](mailto:a@b.com?cc=c@d.com) [y](mailto:a@b.com%0Abcc@evil.com)</p>"},
  {"name": "nested brackets are not a link", "text": "[a [b]](https://e.com)", "html": "<p>[a [b]](https://e.com)</p>"},
  {"name": "parentheses inside a url are not a link", "text": "[x](https://e.com/a_(b))", "html": "<p>[x](https://e.com/a_(b))</p>"},
  {"name": "markup is escaped", "text": "<script>alert(1)</script> <img src=x onerror=alert(1)>", "html": "<p>&lt;script&gt;alert(1)&lt;/script&gt; &lt;img src=x onerror=alert(1)&gt;</p>"},
  {"name": "quotes and ampersands are escaped", "text": "it's \"quoted\" & <ok> &lt;", "html": "<p>it&#039;s &quot;quoted&quot; &amp; &lt;ok&gt; &amp;lt;</p>"},
  {"name": "template directives stay literal text", "text": "{{var x}} and {{template config_path=\"x\"}}", "html": "<p>{{var x}} and {{template config_path=&quot;x&quot;}}</p>"},
  {"name": "null bytes cannot forge placeholders", "text": "\u0000L0\u0000 [a](https://e.com)", "html": "<p>L0 <a href=\"https://e.com\" rel=\"noopener noreferrer nofollow\" target=\"_blank\">a</a></p>"},
  {"name": "non-breaking spaces are not whitespace for emphasis", "text": "a *b* c * d *", "html": "<p>a <em>b</em> c <em> d </em></p>"},
  {"name": "non-ascii text", "text": "Zoë **ünïcøde Å** 😀", "html": "<p>Zoë <strong>ünïcøde Å</strong> 😀</p>"},
  {"name": "trailing spaces on a line are kept", "text": "Line  \nnext", "html": "<p>Line  <br>\nnext</p>"},
  {"name": "mis-nested emphasis", "text": "**a *b** c*", "html": "<p><strong>a <em>b</strong> c</em></p>", "misnested": true}
]
