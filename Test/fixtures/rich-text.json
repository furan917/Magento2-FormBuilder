[
  {"name": "empty text renders nothing", "text": "  \n\n ", "html": ""},
  {"name": "blank lines split paragraphs and single newlines break lines", "text": "One\r\ntwo\n\n\n\nThree", "html": "<p>One<br>\ntwo</p>\n<p>Three</p>"},
  {"name": "bold, italic and both", "text": "a **b** and *c* and ***d***", "html": "<p>a <strong>b</strong> and <em>c</em> and <strong><em>d</em></strong></p>"},
  {"name": "unbalanced markers stay text", "text": "2 * 3 ** 4 *x", "html": "<p>2 * 3 ** 4 *x</p>"},
  {"name": "bulleted list between paragraphs", "text": "Intro\n\n- one **b**\n- two\n\nAfter", "html": "<p>Intro</p>\n<ul><li>one <strong>b</strong></li><li>two</li></ul>\n<p>After</p>"},
  {"name": "paragraph text without a blank line ends a list", "text": "- one\ntext", "html": "<ul><li>one</li></ul>\n<p>text</p>"},
  {"name": "numbered list between paragraphs", "text": "Steps:\n1. First\n2. Second\n\nDone", "html": "<p>Steps:</p>\n<ol><li>First</li><li>Second</li></ol>\n<p>Done</p>"},
  {"name": "list type change starts a new list", "text": "- a\n1. b", "html": "<ul><li>a</li></ul>\n<ol><li>b</li></ol>"},
  {"name": "near misses are not lists", "text": "-not a list\n1.not\n1234. no\n- ", "html": "<p>-not a list<br>\n1.not<br>\n1234. no<br>\n-</p>"},
  {"name": "non-breaking space after the marker still makes an item", "text": "-  x", "html": "<ul><li> x</li></ul>"},
  {"name": "one to three hashes render h3 and four render h4", "text": "# A\n## B\n### C\n#### D", "html": "<h3>A</h3>\n<h3>B</h3>\n<h3>C</h3>\n<h4>D</h4>"},
  {"name": "heading near misses stay text", "text": "##### E\n#no\n# \n x # y", "html": "<p>##### E<br>\n#no<br>\n# <br>\n x # y</p>"},
  {"name": "heading ends a paragraph and a list", "text": "Text\n## Title\n- a\n### Next\nMore", "html": "<p>Text</p>\n<h3>Title</h3>\n<ul><li>a</li></ul>\n<h3>Next</h3>\n<p>More</p>"},
  {"name": "headings keep inline formatting", "text": "### **Bold** and [x](/y)", "html": "<h3><strong>Bold</strong> and <a href=\"/y\">x</a></h3>"},
  {"name": "https link opens in a new tab with a hidden cue", "text": "[Shop](https://example.com/a?x=1&y=2)", "html": "<p><a href=\"https://example.com/a?x=1&amp;y=2\" rel=\"noopener noreferrer\" target=\"_blank\">Shop<span class=\"ffb-sr-only\"> (opens in a new tab)</span></a></p>"},
  {"name": "upper-case scheme is accepted", "text": "[x](HTTPS://Example.com)", "html": "<p><a href=\"HTTPS://Example.com\" rel=\"noopener noreferrer\" target=\"_blank\">x<span class=\"ffb-sr-only\"> (opens in a new tab)</span></a></p>"},
  {"name": "relative and mailto links stay in the tab", "text": "[p](/privacy?a=1) [m](mailto:a@b.com)", "html": "<p><a href=\"/privacy?a=1\">p</a> <a href=\"mailto:a@b.com\">m</a></p>"},
  {"name": "formatting inside link labels", "text": "[**a**](/x) **[b](/y)**", "html": "<p><a href=\"/x\"><strong>a</strong></a> <strong><a href=\"/y\">b</a></strong></p>"},
  {"name": "no emphasis inside urls", "text": "[a](/x*y*z) **b**", "html": "<p><a href=\"/x*y*z\">a</a> <strong>b</strong></p>"},
  {"name": "unsafe and unsupported link targets stay text", "text": "[a](javascript:alert(1)) [b](JaVaScRiPt:x) [c](data:text/html,x) [d](vbscript:x) [e](//evil.com) [f](/\\evil.com) [g](evil.com) [h](mailto:nope) [i](mailto:a@b.com?cc=c@d.com) [j](http://) [k](https:evil.com) [l]() [m](&#106;avascript:x)", "html": "<p>[a](javascript:alert(1)) [b](JaVaScRiPt:x) [c](data:text/html,x) [d](vbscript:x) [e](//evil.com) [f](/\\evil.com) [g](evil.com) [h](mailto:nope) [i](mailto:a@b.com?cc=c@d.com) [j](http://) [k](https:evil.com) [l]() [m](&amp;#106;avascript:x)</p>"},
  {"name": "quotes cannot break out of the href", "text": "[a](https://e.com/\"onclick=\"x) [b](/x'y)", "html": "<p>[a](https://e.com/&quot;onclick=&quot;x) [b](/x&#039;y)</p>"},
  {"name": "html and entities are escaped", "text": "<script>alert(1)</script> &lt;b&gt; **<i>x</i>**", "html": "<p>&lt;script&gt;alert(1)&lt;/script&gt; &amp;lt;b&amp;gt; <strong>&lt;i&gt;x&lt;/i&gt;</strong></p>"},
  {"name": "mis-nested emphasis", "text": "**a *b** c*", "html": "<p><strong>a <em>b</strong> c</em></p>"}
]
