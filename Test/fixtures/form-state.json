  {
    "name": "show action hides the item when the rules do not match",
    "schema": {
      "version": 1,
      "pages": [
        {
          "id": "p_aaaa",
          "title": "aaaa",
          "condition": null,
          "skip": null,
          "items": [
            {
              "id": "f_aaaa",
              "kind": "field",
              "type": "text",
              "name": "a",
              "label": "a",
              "required": false,
              "locked": false,
              "options": [],
              "condition": null
            },
            {
              "id": "f_bbbb",
              "kind": "field",
              "type": "text",
              "name": "b",
              "label": "b",
              "required": false,
              "locked": false,
              "options": [],
              "condition": {
                "actions": [
                  {
                    "action": "show"
                  }
                ],
                "match": "all",
                "rules": [
                  {
                    "field": "a",
                    "operator": "equals",
                    "value": "1"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "values": {
      "a": "2",
      "b": "x"
    },
    "expected": {
      "visible": {
        "p_aaaa": true,
        "f_aaaa": true,
        "f_bbbb": false
      },
      "values": {
        "a": "2"
      }
    }
  },
